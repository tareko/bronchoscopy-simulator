; Engine configuration file.
; Bronchoscopy Simulator — open-source VR airway training.
; Edit through the Godot editor where possible.

config_version=5

[application]

config/name="Bronchoscopy Simulator"
config/description="Open-source VR bronchoscopy training for OpenXR headsets on Linux."
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[debug]

settings/stdout/print_fps=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"

[input]

scope_insert={
"deadzone": 0.15,
"events": []
}
scope_withdraw={
"deadzone": 0.15,
"events": []
}
scope_deflect={
"deadzone": 0.15,
"events": []
}
scope_roll={
"deadzone": 0.15,
"events": []
}
scope_suction={
"deadzone": 0.5,
"events": []
}
tool_deploy={
"deadzone": 0.5,
"events": []
}
tool_switch={
"deadzone": 0.5,
"events": []
}
menu_toggle={
"deadzone": 0.5,
"events": []
}
sim_preview_up={
"deadzone": 0.5,
"events": []
}
sim_preview_down={
"deadzone": 0.5,
"events": []
}
sim_preview_left={
"deadzone": 0.5,
"events": []
}
sim_preview_right={
"deadzone": 0.5,
"events": []
}

[layer_names]

3d_physics/layer_1="airway_wall"
3d_physics/layer_2="scope"
3d_physics/layer_3="lesions"
3d_physics/layer_4="tools"
3d_physics/layer_5="ui"

[physics]

common/physics_ticks_per_second=90
3d/default_gravity=0.0

[rendering]

; Mobile is Godot's recommended rendering method for desktop VR. Fall back to
; "gl_compatibility" on drivers without working Vulkan (see docs/07).
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.025, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0

[xr]

; OpenXR is OFF by default so the project opens and runs on a desktop with no
; headset attached. Enable it per run with scripts/run.sh --vr (which passes
; --xr-mode on), or flip this setting in the editor while the Vive is connected.
openxr/enabled=false
openxr/reference_space=1
openxr/environment_blend_mode=0
openxr/foveation_level=2
openxr/foveation_dynamic=true
shaders/enabled=true
